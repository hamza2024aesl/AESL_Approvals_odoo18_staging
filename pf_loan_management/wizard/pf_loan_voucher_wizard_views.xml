<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pf_loan_voucher_wizard_form" model="ir.ui.view">
        <field name="name">pf.loan.voucher.wizard.form</field>
        <field name="model">pf.loan.voucher.wizard</field>
        <field name="arch" type="xml">
            <form string="Create GP Voucher (Bank Transaction Posting Journal)">
                <group>
                    <group string="Auto-Populated Loan Info">
                        <field name="loan_id" invisible="1"/>
                        <field name="employee_id"/>
                        <field name="loan_amount"/>
                        <field name="loan_amount_words"/>
                    </group>
                    <group string="Voucher Header Info">
                        <field name="audit_trail_code" placeholder="e.g. CMTRX00002049"/>
                        <field name="voucher_date"/>
                        <field name="journal_entry_no" placeholder="e.g. 2,480"/>
                        <field name="posting_date"/>
                    </group>
                </group>
                <group string="Bank &amp; Cheque Details">
                    <group>
                        <field name="check_book_id" placeholder="e.g. SBL-PLS-KIA"/>
                        <field name="cheque_number" placeholder="e.g. 2560"/>
                    </group>
                    <group>
                        <field name="paid_to_rcvd_from" placeholder="e.g. SIRAJUUDIN AKHTER CHQ#85551059"/>
                        <field name="description" placeholder="e.g. SIRAJUUDIN AKH PF LOAN AESL755"/>
                    </group>
                </group>
                <footer>
                    <button name="action_save_voucher_and_approve" string="Create Voucher &amp; Forward to Trustee" type="object" class="btn-primary fw-bold"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pf_loan_voucher_wizard" model="ir.actions.act_window">
        <field name="name">Create GP Voucher</field>
        <field name="res_model">pf.loan.voucher.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
