<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Extend Portal Home: Notification Banner & Portal Category Card -->
    <template id="portal_my_home_doc_request" name="Employee Document Request Notification" inherit_id="portal.portal_my_home" priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <!-- Pending Document Request Alert Notification Banner -->
            <t t-if="pending_doc_request_count and pending_doc_request_count &gt; 0">
                <div class="alert alert-info alert-dismissible fade show shadow-sm mb-4 border-info" role="alert" style="border-left: 5px solid #17a2b8;">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa fa-file-text-o fa-2x text-info me-3"/>
                        <div>
                            <h5 class="alert-heading mb-1 font-weight-bold">Document Request Pending</h5>
                            <p class="mb-0 text-muted">
                                HR / Management has requested <strong><t t-esc="pending_doc_request_count"/></strong> document(s) from you. Please upload and digitally sign them.
                            </p>
                        </div>
                    </div>
                    <hr class="my-2"/>
                    <div class="list-group list-group-flush bg-transparent">
                        <t t-foreach="pending_doc_requests" t-as="p_doc">
                            <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 py-2 border-0">
                                <div>
                                    <strong class="text-dark" t-esc="p_doc.name"/>
                                    <t t-if="p_doc.deadline">
                                        <small class="text-danger ms-2">
                                            (Deadline: <t t-esc="p_doc.deadline"/>)
                                        </small>
                                    </t>
                                </div>
                                <a t-attf-href="/my/document_request/{{p_doc.id}}" class="btn btn-info text-white btn-sm rounded-pill px-3 fw-bold">
                                    <i class="fa fa-upload me-1"/> Upload &amp; Sign
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@id='portal_custom_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/prodo_user_portal/static/description/icons/icons8-performance-64.png'"/>
                <t t-set="title">Document Requests</t>
                <t t-set="text">Upload &amp; Digitally Sign Requested Documents</t>
                <t t-set="url" t-value="'/my/document_requests'"/>
                <t t-set="placeholder_count" t-value="'doc_request_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- 2. Portal Breadcrumbs -->
    <template id="portal_my_home_menu_doc_request" name="Portal layout : Document Request menu entries" inherit_id="portal.portal_breadcrumbs" priority="25">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'doc_request'" class="breadcrumb-item active">
                Document Requests
            </li>
        </xpath>
    </template>

    <!-- 3. Portal List Page (/my/document_requests) -->
    <template id="portal_my_doc_requests_list" name="My Document Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="card shadow-sm border-0 mt-3">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 font-weight-bold text-primary">My Document Requests</h4>
                </div>
                <div class="card-body">
                    <t t-if="not doc_requests">
                        <div class="alert alert-info text-center my-4" role="alert">
                            <i class="fa fa-info-circle me-2"/> You have no document requests.
                        </div>
                    </t>
                    <t t-else="">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Document Requested</th>
                                        <th>Status</th>
                                        <th>Deadline</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc_requests" t-as="req">
                                        <tr>
                                            <td>
                                                <strong t-esc="req.name"/>
                                            </td>
                                            <td>
                                                <span t-if="req.state == 'pending'" class="badge bg-warning text-dark">Pending Upload</span>
                                                <span t-elif="req.state == 'submitted'" class="badge bg-info text-white">Submitted</span>
                                                <span t-elif="req.state == 'approved'" class="badge bg-success">Approved</span>
                                                <span t-elif="req.state == 'rejected'" class="badge bg-danger">Rejected</span>
                                                <span t-else="" class="badge bg-secondary" t-esc="req.state"/>
                                            </td>
                                            <td>
                                                <t t-if="req.deadline">
                                                    <span t-esc="req.deadline"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">-</span>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <a t-attf-href="/my/document_request/{{req.id}}" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                                                    <t t-if="req.state == 'pending'">
                                                        <i class="fa fa-upload me-1"/> Upload &amp; Sign
                                                    </t>
                                                    <t t-else="">
                                                        <i class="fa fa-eye me-1"/> View Submission
                                                    </t>
                                                </a>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div t-if="pager" class="d-flex justify-content-center mt-3">
                            <t t-call="portal.pager"/>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- 4. Portal Form/Detail Page (/my/document_request/<id>) -->
    <template id="portal_doc_request_form" name="Document Request Form">
        <t t-call="portal.portal_layout">
            <div class="container my-4">
                <div class="row justify-content-center">
                    <div class="col-md-10">
                        <div class="card shadow border-0 rounded-lg">
                            <div class="card-header bg-primary text-white py-3">
                                <h4 class="mb-0 font-weight-bold">
                                    <i class="fa fa-file-text-o me-2"/>
                                    <t t-esc="doc_req.name"/>
                                </h4>
                            </div>
                            <div class="card-body p-4">
                                <!-- Submitted Confirmation Banner -->
                                <t t-if="doc_req.state in ['submitted', 'approved'] or request.params.get('submitted')">
                                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                                        <h5 class="alert-heading font-weight-bold">
                                            <i class="fa fa-check-circle me-2"/> Document Submitted Successfully!
                                        </h5>
                                        <p class="mb-0">
                                            Your uploaded document and digital signature have been received and saved into HR Documents.
                                        </p>
                                    </div>
                                </t>

                                <!-- Instructions -->
                                <div class="bg-light p-3 rounded mb-4 border">
                                    <h6 class="font-weight-bold text-dark mb-2">Instructions from HR:</h6>
                                    <p class="mb-1 text-secondary">
                                        <t t-if="doc_req.instructions" t-esc="doc_req.instructions"/>
                                        <t t-else="">Please upload the requested document file and provide your digital signature below.</t>
                                    </p>
                                    <t t-if="doc_req.deadline">
                                        <span class="badge bg-danger mt-2">
                                            Deadline: <t t-esc="doc_req.deadline"/>
                                        </span>
                                    </t>
                                </div>

                                <!-- Form Submission -->
                                <form t-attf-action="/my/document_request/submit" method="post" enctype="multipart/form-data" id="portal-doc-request-form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="req_id" t-att-value="doc_req.id"/>
                                    <input type="hidden" name="signature_data" id="signature_data"/>

                                    <t t-if="doc_req.state in ['draft', 'pending', 'rejected']">
                                        <!-- File Upload Section -->
                                        <div class="form-group mb-4">
                                            <label class="form-label font-weight-bold text-dark">
                                                Select Document File to Upload <span class="text-danger">*</span>
                                            </label>
                                            <input type="file" name="attachment_file" class="form-control form-control-lg" required="required" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx"/>
                                            <small class="form-text text-muted">Supported formats: PDF, PNG, JPG, DOCX.</small>
                                        </div>

                                        <!-- Signatory Name -->
                                        <div class="form-group mb-4">
                                            <label class="form-label font-weight-bold text-dark">
                                                Full Name of Signatory <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" name="signed_by" class="form-control" t-att-value="request.env.user.name" required="required"/>
                                        </div>

                                        <!-- Digital Signature Canvas -->
                                        <div class="form-group mb-4">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <label class="form-label font-weight-bold text-dark mb-0">
                                                    Draw Digital Signature <span class="text-danger">*</span>
                                                </label>
                                                <button type="button" class="btn btn-sm btn-outline-danger" id="clear-signature-btn">
                                                    <i class="fa fa-eraser me-1"/> Clear Signature
                                                </button>
                                            </div>
                                            <div class="border rounded bg-white p-2 text-center" style="box-shadow: inset 0 0 5px rgba(0,0,0,0.1);">
                                                <canvas id="signature-canvas" style="width: 100%; height: 180px; cursor: crosshair; touch-action: none; background: #ffffff;"></canvas>
                                            </div>
                                            <small class="form-text text-muted">Use mouse or touch screen to draw your signature inside the box.</small>
                                        </div>

                                        <div class="d-grid gap-2 mt-4">
                                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow">
                                                <i class="fa fa-paper-plane me-2"/> Submit Document &amp; Signature
                                            </button>
                                        </div>
                                    </t>

                                    <!-- Read-Only View of Submission -->
                                    <t t-else="">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <h6 class="font-weight-bold">Uploaded File:</h6>
                                                <t t-if="doc_req.attachment_id">
                                                    <a t-attf-href="/web/content/{{doc_req.attachment_id.id}}?download=true" class="btn btn-outline-success btn-sm">
                                                        <i class="fa fa-download me-1"/> Download <t t-esc="doc_req.attachment_id.name"/>
                                                    </a>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">No attachment</span>
                                                </t>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <h6 class="font-weight-bold">Digital Signature:</h6>
                                                <t t-if="doc_req.signature">
                                                    <img t-attf-src="data:image/png;base64,{{doc_req.signature}}" class="border rounded p-1 bg-white" style="max-height: 120px;"/>
                                                    <div class="small text-muted mt-1">
                                                        Signed by <strong><t t-esc="doc_req.signed_by"/></strong> on <t t-esc="doc_req.signed_on"/>
                                                    </div>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">No signature</span>
                                                </t>
                                            </div>
                                        </div>
                                    </t>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Guaranteed Inline Canvas Signature Pad Initialization -->
            <script type="text/javascript">
                (function() {
                    function setupCanvas() {
                        var canvas = document.getElementById("signature-canvas");
                        if (!canvas) return;
                        if (canvas.getAttribute("data-ready") === "true") return;
                        canvas.setAttribute("data-ready", "true");

                        var ctx = canvas.getContext("2d");
                        var isDrawing = false;
                        var hasSignature = false;

                        canvas.width = canvas.parentElement.clientWidth || 500;
                        canvas.height = 180;

                        ctx.fillStyle = "#ffffff";
                        ctx.fillRect(0, 0, canvas.width, canvas.height);

                        ctx.strokeStyle = "#000000";
                        ctx.lineWidth = 2.5;
                        ctx.lineCap = "round";
                        ctx.lineJoin = "round";

                        function getPos(e) {
                            var rect = canvas.getBoundingClientRect();
                            if (e.touches &amp;&amp; e.touches.length &gt; 0) {
                                return {
                                    x: e.touches[0].clientX - rect.left,
                                    y: e.touches[0].clientY - rect.top
                                };
                            }
                            return {
                                x: e.clientX - rect.left,
                                y: e.clientY - rect.top
                            };
                        }

                        function startDrawing(e) {
                            isDrawing = true;
                            var pos = getPos(e);
                            ctx.beginPath();
                            ctx.moveTo(pos.x, pos.y);
                        }

                        function draw(e) {
                            if (!isDrawing) return;
                            if (e.cancelable) e.preventDefault();
                            var pos = getPos(e);
                            ctx.lineTo(pos.x, pos.y);
                            ctx.stroke();
                            hasSignature = true;
                        }

                        function stopDrawing() {
                            isDrawing = false;
                        }

                        canvas.addEventListener("mousedown", startDrawing);
                        canvas.addEventListener("mousemove", draw);
                        canvas.addEventListener("mouseup", stopDrawing);
                        canvas.addEventListener("mouseleave", stopDrawing);

                        canvas.addEventListener("touchstart", startDrawing, { passive: false });
                        canvas.addEventListener("touchmove", draw, { passive: false });
                        canvas.addEventListener("touchend", stopDrawing);

                        var clearBtn = document.getElementById("clear-signature-btn");
                        if (clearBtn) {
                            clearBtn.addEventListener("click", function() {
                                ctx.fillStyle = "#ffffff";
                                ctx.fillRect(0, 0, canvas.width, canvas.height);
                                hasSignature = false;
                                var sigInput = document.getElementById("signature_data");
                                if (sigInput) sigInput.value = "";
                            });
                        }

                        var form = document.getElementById("portal-doc-request-form");
                        if (form) {
                            form.addEventListener("submit", function() {
                                if (hasSignature) {
                                    var sigInput = document.getElementById("signature_data");
                                    if (sigInput) {
                                        sigInput.value = canvas.toDataURL("image/png");
                                    }
                                }
                            });
                        }
                    }

                    if (document.readyState === "loading") {
                        document.addEventListener("DOMContentLoaded", setupCanvas);
                    } else {
                        setupCanvas();
                    }
                    setInterval(setupCanvas, 300);
                })();
            </script>
        </t>
    </template>


</odoo>
