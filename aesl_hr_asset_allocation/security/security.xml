<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multi-Company Rule -->
    <record id="rule_hr_asset_allocation_multi_company" model="ir.rule">
        <field name="name">Asset Allocation Multi-Company Rule</field>
        <field name="model_id" ref="model_hr_asset_allocation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Department Head Visibility Rule (Portal / Internal Heads see their own department's allocations) -->
    <record id="rule_hr_asset_allocation_dept_head" model="ir.rule">
        <field name="name">Department Head Asset Allocation Access</field>
        <field name="model_id" ref="model_hr_asset_allocation"/>
        <field name="domain_force">['|', ('department_head_id', '=', user.id), ('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- HR Officers / Managers Access to All Allocations -->
    <record id="rule_hr_asset_allocation_officer" model="ir.rule">
        <field name="name">HR Officers All Asset Allocations</field>
        <field name="model_id" ref="model_hr_asset_allocation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

</odoo>
