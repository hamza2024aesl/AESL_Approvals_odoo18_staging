<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_asset_allocation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.asset.allocation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="Asset Allocation &amp; Departmental Approvals" name="asset_allocation_settings_container">
                    <setting id="setting_asset_admin_head" string="Admin Department Head" help="Responsible for allocating vehicle, fuel card, keys, ID card, and administrative assets.">
                        <field name="asset_admin_head_id" class="w-100"/>
                    </setting>
                    <setting id="setting_asset_it_head" string="IT Department Head" help="Responsible for allocating laptop, CWS credentials, official email, and IT equipment.">
                        <field name="asset_it_head_id" class="w-100"/>
                    </setting>
                    <setting id="setting_asset_hse_head" string="HSE Department Head" help="Responsible for allocating helmet, safety goggles, uniform, and HSE cards.">
                        <field name="asset_hse_head_id" class="w-100"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
