<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Custom Paperformat: A4 Portrait with standard AESL margins -->
    <record id="paperformat_aesl_resignation_acceptance" model="report.paperformat">
        <field name="name">AESL Resignation Acceptance Memorandum A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">22</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">20</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">15</field>
        <field name="dpi">96</field>
    </record>

    <!-- 2. Report Action -->
    <record id="action_report_resignation_acceptance" model="ir.actions.report">
        <field name="name">Resignation Acceptance Form (Memorandum)</field>
        <field name="model">employee.resignation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aesl_hr_resignation.report_resignation_acceptance_template</field>
        <field name="report_file">aesl_hr_resignation.report_resignation_acceptance_template</field>
        <field name="print_report_name">'Resignation_Acceptance_' + (object.emp_name.name or '').replace(' ', '_')</field>
        <field name="binding_model_id" ref="ivis_employee_details.model_employee_resignation"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="aesl_hr_resignation.paperformat_aesl_resignation_acceptance"/>
    </record>

    <!-- 3. Report QWeb Template -->
    <template id="report_resignation_acceptance_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" style="font-family: Arial, Helvetica, sans-serif; font-size: 13.5px; color: #111111; line-height: 1.5;">
                    <div class="page" style="margin: 0; padding: 0;">

                        <!-- Memorandum Label -->
                        <div style="font-size: 12px; font-weight: bold; color: #666666; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 1px;">
                            Memorandum
                        </div>

                        <!-- Allied CAT Banner Header -->
                        <table style="width: 100%; border-bottom: 2px solid #222222; padding-bottom: 14px; margin-bottom: 22px; border-collapse: collapse;">
                            <tr>
                                <td style="vertical-align: top; width: 42%;">
                                    <div style="background-color: #ffcc00; display: inline-block; padding: 5px 14px; border-radius: 2px;">
                                        <span style="font-size: 22px; font-weight: 900; color: #000000; letter-spacing: -1px;">ALLIED</span>
                                        <span style="font-size: 18px; font-weight: 900; background: #000000; color: #ffcc00; padding: 2px 6px; margin-left: 4px; border-radius: 2px;">CAT</span>
                                    </div>
                                </td>
                                <td style="vertical-align: top; text-align: left; font-size: 11px; color: #333333; line-height: 1.4; padding-left: 15px;">
                                    <strong style="font-size: 12.5px; color: #000000;">Allied Engineering &amp; Services Ltd.</strong><br/>
                                    21/3, Sector No. 22, Korangi Industrial Area, Karachi-74900, G.P.O. Box 940, Karachi - 74200,<br/>
                                    UAN: 111 250 250 Tel: (021) 506 6901-13 Fax: (021) 506 6915 &amp; 16 email: admin@aesl.com.pk
                                </td>
                            </tr>
                        </table>

                        <!-- Reference & Meta Info Block -->
                        <table style="width: 100%; font-size: 13.5px; margin-bottom: 20px; border-collapse: collapse;">
                            <tr>
                                <td style="width: 14%; padding: 4px 0; font-weight: bold; color: #000000;">Ref</td>
                                <td style="width: 3%; padding: 4px 0; font-weight: bold;">:</td>
                                <td style="width: 83%; padding: 4px 0; font-weight: bold; color: #000000;">
                                    <t t-esc="o.name or 'AESL/PER/MEMO'"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 4px 0; font-weight: bold; color: #000000;">Date</td>
                                <td style="padding: 4px 0; font-weight: bold;">:</td>
                                <td style="padding: 4px 0;">
                                    <t t-esc="(o.acceptance_date or o.write_date).strftime('%B %d, %Y') if (o.acceptance_date or o.write_date) else ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 4px 0; font-weight: bold; color: #000000; vertical-align: top;">To</td>
                                <td style="padding: 4px 0; font-weight: bold; vertical-align: top;">:</td>
                                <td style="padding: 4px 0;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="font-weight: bold; font-size: 14px; color: #000000;">
                                                Mr./Ms. <t t-esc="o.emp_name.name"/>
                                            </td>
                                            <td style="text-align: right; font-weight: bold; color: #000000;">
                                                Emp. No. <t t-esc="o.emp_badge or o.emp_name.barcode or o.emp_name.id"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="color: #444444; font-size: 13px; padding-top: 2px;">
                                                <t t-esc="o.emp_designation.name or '-'"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="color: #444444; font-size: 13px; padding-top: 2px;">
                                                Department: <t t-esc="o.department.name or '-'"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="color: #444444; font-size: 13px; padding-top: 2px;">
                                                <u><t t-esc="o.station or o.emp_name.work_location_name or 'Karachi'"/></u>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Subject -->
                        <table style="width: 100%; font-size: 14px; margin-bottom: 22px; border-collapse: collapse;">
                            <tr>
                                <td style="width: 14%; padding: 4px 0; font-weight: bold; color: #000000;">Subject</td>
                                <td style="width: 3%; padding: 4px 0; font-weight: bold;">:</td>
                                <td style="width: 83%; padding: 4px 0; font-weight: bold; color: #000000; text-decoration: underline; letter-spacing: 0.5px;">
                                    RESIGNATION FROM SERVICE
                                </td>
                            </tr>
                        </table>

                        <!-- Body Content -->
                        <div style="font-size: 14px; line-height: 1.8; color: #222222; text-align: justify; margin-bottom: 25px;">
                            <p style="margin-bottom: 16px;">
                                Kindly refer to your resignation dated: <strong><t t-esc="o.resignation_date.strftime('%B %d, %Y') if o.resignation_date else '-'"/></strong>, please be advised that your resignation has been accepted and you have been relieved of your duties with effect from <strong><t t-esc="o.expected_exit_date.strftime('%B %d, %Y') if o.expected_exit_date else (o.exit_date or '-')"/></strong>.
                            </p>
                            <p style="margin-bottom: 16px;">
                                You are requested to kindly coordinate with the Accounts Department for the final settlement of your dues after completing the asset and departmental clearance procedures (Admin, IT, HSE).
                            </p>
                            <t t-if="o.manager_remarks">
                                <p style="margin-top: 15px; font-style: italic; color: #555555; background-color: #fafafa; padding: 10px 14px; border-left: 3px solid #ffcc00;">
                                    <strong>Manager Remarks:</strong> <t t-esc="o.manager_remarks"/>
                                </p>
                            </t>
                        </div>

                        <!-- Signatures & Authority Section -->
                        <table style="width: 100%; border-collapse: collapse; margin-top: 60px;">
                            <tr>
                                <td style="width: 55%; vertical-align: top; font-size: 13.5px; line-height: 1.5;">
                                    Yours Faithfully,<br/>
                                    <strong>For ALLIED ENGINEERING &amp; SERVICES LTD.</strong>
                                    <div style="height: 55px;"/>
                                    <div style="border-top: 1px solid #000000; width: 230px; padding-top: 4px;">
                                        <strong>Authorized Signatory / HR Dept.</strong>
                                    </div>
                                </td>
                                <td style="width: 45%; vertical-align: top; font-size: 13.5px; padding-left: 20px;">
                                    <br/>
                                    <strong>Employee Acknowledgement:</strong>
                                    <div style="height: 55px;"/>
                                    <div style="border-top: 1px solid #000000; width: 220px; padding-top: 4px;">
                                        <strong><t t-esc="o.emp_name.name"/></strong><br/>
                                        Date: ________________________
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Official Memorandum Footer -->
                        <table style="width: 100%; border-collapse: collapse; margin-top: 45px; border-top: 1px dashed #cccccc; padding-top: 10px; font-size: 11px; color: #777777;">
                            <tr>
                                <td style="width: 60%;">
                                    cc: &amp;nbsp; Personal File<br/>
                                    &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Accounts Department
                                </td>
                                <td style="width: 40%; text-align: right; vertical-align: bottom;">
                                    Official Memorandum &#183; AESL HR System
                                </td>
                            </tr>
                        </table>

                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>

