<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Employee Resignation / Memorandum Reference -->
        <record id="seq_employee_resignation" model="ir.sequence">
            <field name="name">Employee Resignation Reference</field>
            <field name="code">employee.resignation</field>
            <field name="prefix">AESL/PER/%(year)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

