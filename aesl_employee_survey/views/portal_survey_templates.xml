<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Extend Portal My Home: Add Pending Survey Alert Notification + Portal Card -->
    <template id="portal_my_home_survey" name="Employee Survey Portal Notification" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <!-- Pending Survey Alert Notification Banner -->
            <t t-if="pending_survey_count and pending_survey_count &gt; 0">
                <div class="alert alert-warning alert-dismissible fade show shadow-sm mb-4 border-warning" role="alert" style="border-left: 5px solid #ffc107;">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa fa-exclamation-triangle fa-2x text-warning me-3"/>
                        <div>
                            <h5 class="alert-heading mb-1 font-weight-bold">Fill Your Survey Form</h5>
                            <p class="mb-0 text-muted">
                                You have <strong><t t-esc="pending_survey_count"/></strong> pending survey(s) assigned to you by HR / Management. Please complete them as soon as possible.
                            </p>
                        </div>
                    </div>
                    <hr class="my-2"/>
                    <div class="list-group list-group-flush bg-transparent">
                        <t t-foreach="pending_surveys" t-as="p_survey">
                            <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 py-2 border-0">
                                <div>
                                    <strong class="text-dark" t-esc="p_survey.survey_id.title"/>
                                    <t t-if="p_survey.deadline">
                                        <small class="text-danger ms-2">
                                            (Deadline: <t t-esc="p_survey.deadline"/>)
                                        </small>
                                    </t>
                                </div>
                                <a t-att-href="p_survey.get_authenticated_start_url()" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                                    <i class="fa fa-pencil-square-o me-1"/> Fill Your Survey Form
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@id='portal_custom_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/prodo_user_portal/static/description/icons/icons8-performance-64.png'"/>
                <t t-set="title">Surveys</t>
                <t t-set="text">Fill &amp; View Employee Surveys</t>
                <t t-set="url" t-value="'/my/surveys'"/>
                <t t-set="placeholder_count" t-value="'survey_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- 2. Portal Breadcrumbs for Surveys -->
    <template id="portal_my_home_menu_survey" name="Portal layout : Survey menu entries" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'survey'" class="breadcrumb-item active">
                Employee Surveys
            </li>
        </xpath>
    </template>

    <!-- 3. List Page for Employee Surveys (/my/surveys) -->
    <template id="portal_my_surveys_list" name="My Employee Surveys">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="card shadow-sm border-0 mt-3">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 font-weight-bold text-primary">My Employee Surveys</h4>
                </div>
                <div class="card-body">
                    <t t-if="not surveys">
                        <div class="alert alert-info text-center my-4" role="alert">
                            <i class="fa fa-info-circle me-2"/> There are currently no surveys assigned to you.
                        </div>
                    </t>
                    <t t-else="">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Survey Title</th>
                                        <th>Status</th>
                                        <th>Deadline</th>
                                        <th>Score</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="surveys" t-as="survey_line">
                                        <tr>
                                            <td>
                                                <strong t-esc="survey_line.survey_id.title"/>
                                            </td>
                                            <td>
                                                <span t-if="survey_line.state == 'new'" class="badge bg-warning text-dark">Pending</span>
                                                <span t-elif="survey_line.state == 'in_progress'" class="badge bg-info text-white">In Progress</span>
                                                <span t-elif="survey_line.state == 'done'" class="badge bg-success">Completed</span>
                                            </td>
                                            <td>
                                                <t t-if="survey_line.deadline">
                                                    <span t-esc="survey_line.deadline"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">-</span>
                                                </t>
                                            </td>
                                            <td>
                                                <t t-if="survey_line.state == 'done'">
                                                    <span t-esc="'%.1f%%' % survey_line.scoring_percentage"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">-</span>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="survey_line.state in ['new', 'in_progress']">
                                                    <a t-att-href="survey_line.get_start_url()" class="btn btn-primary btn-sm px-3 rounded-pill">
                                                        <i class="fa fa-pencil-square-o me-1"/> Fill &amp; Submit Form
                                                    </a>
                                                </t>
                                                <t t-else="">
                                                    <a t-att-href="survey_line.get_print_url()" class="btn btn-outline-secondary btn-sm px-3 rounded-pill" target="_blank">
                                                        <i class="fa fa-eye me-1"/> Review Answers
                                                    </a>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div t-if="pager" class="d-flex justify-content-center mt-3">
                            <t t-call="portal.pager"/>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>

