<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_approval_travel_expense" model="ir.sequence">
        <field name="name">Travel Expense</field>
        <field name="code">approval.travel.expense</field>
        <field name="prefix">TEXP/%(year)s/</field>
        <field name="padding">4</field>
    </record>


    <record id="approvals_manager_assistant_root" model="ir.module.category">
        <field name="name">Manager's Assistant</field>
    </record>


    <record id="approvals_manager_assistant" model="res.groups">
        <field name="name">Manager's Assistant</field>
        <field name="category_id" ref="approvals_manager_assistant_root"/>
    </record>

</odoo>