<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 1. Email Template to Candidate -->
        <record id="mail_template_candidate_offer_letter" model="mail.template">
            <field name="name">Candidate: Employment Offer Letter</field>
            <field name="model_id" ref="model_hr_offer_letter"/>
            <field name="subject">Employment Offer: {{ object.job_id.name }} - {{ object.company_id.name }} (Ref: {{ object.name }})</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 15px; color: #333333; line-height: 1.6; max-width: 650px; margin: 0 auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px; background-color: #ffffff;">
    <div style="text-align: center; border-bottom: 2px solid #004085; padding-bottom: 15px; margin-bottom: 20px;">
        <h2 style="color: #004085; margin: 0; font-size: 22px; text-transform: uppercase; letter-spacing: 1px;">
            <t t-out="object.company_id.name or 'Allied Engineering &amp; Services (Pvt.) Ltd.'"/>
        </h2>
        <p style="margin: 5px 0 0 0; color: #666; font-size: 13px;">OFFER OF EMPLOYMENT</p>
    </div>

    <p>Dear <strong><t t-out="object.candidate_name"/></strong>,</p>

    <p>With reference to your application and subsequent interviews, we have the pleasure of extending an offer of employment with <strong><t t-out="object.company_id.name"/></strong> for the position of <strong><t t-out="object.job_id.name"/></strong> in the <strong><t t-out="object.department_id.name"/></strong>.</p>

    <div style="background-color: #f8f9fa; border-left: 4px solid #004085; padding: 15px; margin: 20px 0; border-radius: 4px;">
        <h4 style="margin: 0 0 10px 0; color: #004085; font-size: 16px;">Summary of Offer Details</h4>
        <table style="width: 100%; font-size: 14px; border-collapse: collapse;">
            <tr>
                <td style="padding: 6px 0; color: #555; width: 40%;"><strong>Designation:</strong></td>
                <td style="padding: 6px 0; color: #111;"><strong><t t-out="object.job_id.name"/></strong></td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #555;"><strong>Department:</strong></td>
                <td style="padding: 6px 0; color: #111;"><t t-out="object.department_id.name"/></td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #555;"><strong>Place of Posting:</strong></td>
                <td style="padding: 6px 0; color: #111;"><t t-out="object.posting_location or 'Multan'"/></td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #555;"><strong>Proposed Joining Date:</strong></td>
                <td style="padding: 6px 0; color: #111;"><strong><t t-out="object.joining_date"/></strong></td>
            </tr>
            <tr>
                <td style="padding: 6px 0; color: #555;"><strong>Monthly Gross Salary:</strong></td>
                <td style="padding: 6px 0; color: #004085; font-size: 15px;"><strong><t t-out="object.currency_id.symbol or 'Rs.'"/> <t t-out="'{:,.2f}'.format(object.gross_salary)"/></strong></td>
            </tr>
        </table>
    </div>

    <p>Please find attached the official Offer Letter (PDF) containing the comprehensive terms, conditions, and benefits.</p>

    <p style="font-weight: bold; margin-top: 25px;">Please confirm your decision by clicking one of the options below:</p>

    <!-- Call to Action Buttons -->
    <div style="text-align: center; margin: 30px 0;">
        <a t-att-href="object.get_accept_url()"
           style="background-color: #28a745; color: #ffffff; text-decoration: none; padding: 12px 28px; font-size: 15px; font-weight: bold; border-radius: 6px; display: inline-block; margin-right: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
            ✔ ACCEPT OFFER
        </a>
        <a t-att-href="object.get_reject_url()"
           style="background-color: #dc3545; color: #ffffff; text-decoration: none; padding: 12px 28px; font-size: 15px; font-weight: bold; border-radius: 6px; display: inline-block; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
            ✖ REJECT OFFER
        </a>
    </div>

    <p style="font-size: 13px; color: #777; text-align: center;">
        If you have any questions or require revisions regarding your joining or package, you may click "Reject Offer" to submit your feedback, or reply directly to this email.
    </p>

    <div style="border-top: 1px solid #e0e0e0; margin-top: 25px; padding-top: 15px; font-size: 13px; color: #666;">
        <p style="margin: 0;">Warm regards,</p>
        <p style="margin: 5px 0 0 0; font-weight: bold; color: #333;"><t t-out="object.hr_manager_id.name or 'Human Resources Team'"/></p>
        <p style="margin: 0; color: #777;"><t t-out="object.signatory_title or 'Allied Engineering &amp; Services (Pvt.) Ltd.'"/></p>
    </div>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>


        <!-- 2. Email Template for Onboarding Notification to HR/Managers -->
        <record id="mail_template_onboarding_notification" model="mail.template">
            <field name="name">Internal: Candidate Onboarded Notification</field>
            <field name="model_id" ref="model_hr_offer_letter"/>
            <field name="subject">New Employee Onboarded: {{ object.candidate_name }} ({{ object.job_id.name }})</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="body_html" type="html">
<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 14px; color: #333; line-height: 1.6; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #dcdcdc; border-radius: 8px;">
    <div style="background-color: #28a745; color: white; padding: 12px 15px; border-radius: 6px 6px 0 0; margin: -20px -20px 20px -20px;">
        <h3 style="margin: 0; font-size: 18px;">🎉 Candidate Successfully Onboarded!</h3>
    </div>

    <p>Dear Team,</p>
    <p>We are pleased to notify you that the following candidate has officially accepted the employment offer and has been onboarded into Odoo:</p>

    <table style="width: 100%; border-collapse: collapse; margin: 15px 0; font-size: 14px;">
        <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 8px; color: #555; width: 35%;"><strong>Employee Name:</strong></td>
            <td style="padding: 8px; color: #111;"><strong><t t-out="object.candidate_name"/></strong></td>
        </tr>
        <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 8px; color: #555;"><strong>Designation:</strong></td>
            <td style="padding: 8px; color: #111;"><t t-out="object.job_id.name"/></td>
        </tr>
        <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 8px; color: #555;"><strong>Department:</strong></td>
            <td style="padding: 8px; color: #111;"><t t-out="object.department_id.name"/></td>
        </tr>
        <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 8px; color: #555;"><strong>Joining Date:</strong></td>
            <td style="padding: 8px; color: #111;"><strong><t t-out="object.joining_date"/></strong></td>
        </tr>
        <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 8px; color: #555;"><strong>CNIC:</strong></td>
            <td style="padding: 8px; color: #111;"><t t-out="object.cnic or '-'"/></td>
        </tr>
        <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 8px; color: #555;"><strong>Mobile No.:</strong></td>
            <td style="padding: 8px; color: #111;"><t t-out="object.phone or '-'"/></td>
        </tr>
        <tr>
            <td style="padding: 8px; color: #555;"><strong>Offer Reference:</strong></td>
            <td style="padding: 8px; color: #111;"><t t-out="object.name"/></td>
        </tr>
    </table>

    <p style="margin-top: 20px;">The Employee record and Contract draft have been automatically created in the system.</p>

    <div style="border-top: 1px solid #eee; margin-top: 20px; padding-top: 10px; font-size: 12px; color: #888;">
        Automated Notification from AESL HR Management System.
    </div>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>
