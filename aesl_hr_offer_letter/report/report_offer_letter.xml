<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Custom Paperformat: A4 Portrait with exact margins for AESL Official Letterhead & Archive Filing -->
    <record id="paperformat_aesl_appointment_letter" model="report.paperformat">
        <field name="name">AESL Appointment Letter A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">28</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">24</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">96</field>
    </record>

    <!-- 2. Report Action Linked with Custom Paperformat -->
    <record id="action_report_hr_offer_letter" model="ir.actions.report">
        <field name="name">Appointment Letter</field>
        <field name="model">hr.offer.letter</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aesl_hr_offer_letter.report_offer_letter_template</field>
        <field name="report_file">aesl_hr_offer_letter.report_offer_letter_template</field>
        <field name="print_report_name">'Appointment_Letter_' + (object.candidate_name or '').replace(' ', '_')</field>
        <field name="binding_model_id" ref="model_hr_offer_letter"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="aesl_hr_offer_letter.paperformat_aesl_appointment_letter"/>
    </record>

    <!-- 3. Report QWeb Template -->
    <template id="report_offer_letter_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" style="font-family: 'Times New Roman', Times, serif; font-size: 14px; color: #000000; line-height: 1.4;">

                    <!-- ========================================================
                         PAGE 1
                    ========================================================= -->
                    <div class="page" style="margin: 0; padding: 0;">
                        
                        <!-- Top Header Area (Letterhead spacing or logo) -->
                        <div style="height: 45px; margin-bottom: 12px;">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Company Logo" style="max-height: 45px;"/>
                        </div>

                        <!-- Reference Number -->
                        <div style="margin-bottom: 14px; font-size: 14px;">
                            <t t-esc="o.name"/>
                        </div>

                        <!-- Date -->
                        <div style="margin-bottom: 20px; font-size: 14px;">
                            <t t-esc="o.date.strftime('%B %d, %Y') if o.date else ''"/>
                        </div>

                        <!-- Addressee Block (Matching Image 1) -->
                        <div style="margin-bottom: 20px; font-size: 14px; line-height: 1.35;">
                            <strong>
                                <t t-if="o.gender == 'female'">Ms. </t>
                                <t t-else="">Mr. </t><t t-esc="o.candidate_name"/>
                            </strong><br/>
                            <t t-if="o.present_address">
                                <span style="white-space: pre-line;"><t t-esc="o.present_address"/></span><br/>
                            </t>
                            <t t-if="o.cnic">
                                <span>CNIC <t t-esc="o.cnic"/></span><br/>
                            </t>
                            <t t-if="o.phone">
                                <span>Mobile No. <t t-esc="o.phone"/></span>
                            </t>
                        </div>

                        <!-- Salutation -->
                        <div style="margin-bottom: 16px; font-size: 14px;">
                            Dear 
                            <t t-if="o.gender == 'female'">Ms. </t>
                            <t t-else="">Mr. </t><t t-esc="o.candidate_name"/>,
                        </div>

                        <!-- Subject -->
                        <div style="margin-bottom: 16px; font-size: 14px; font-weight: bold;">
                            Subject: Offer of Employment
                        </div>

                        <!-- Opening Paragraph -->
                        <p style="text-align: justify; margin-bottom: 16px; line-height: 1.4;">
                            With reference to your application and subsequent interviews we have the pleasure in offering you employment with our <t t-esc="o.department_id.name"/> as <strong>"<t t-esc="o.job_id.name"/><t t-if="o.posting_location"> (<t t-esc="o.posting_location"/>)</t>"</strong> on the following terms and conditions:
                        </p>

                        <!-- 1. Salary -->
                        <div style="margin-bottom: 18px;">
                            <div style="text-decoration: underline; margin-bottom: 4px;">1. Salary</div>
                            <table style="width: 72%; margin-left: 20px; font-size: 14px; border-collapse: collapse;">
                                <tr>
                                    <td style="padding: 2px 0; width: 45%;">Basic pay</td>
                                    <td style="padding: 2px 0; width: 12%;">Rs.</td>
                                    <td style="padding: 2px 0; text-align: right; width: 43%; font-family: 'Times New Roman', serif;">
                                        <t t-esc="'{:,.2f}'.format(o.basic_salary)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 0;">House Rent</td>
                                    <td style="padding: 2px 0;"></td>
                                    <td style="padding: 2px 0; text-align: right; font-family: 'Times New Roman', serif;">
                                        <t t-esc="'{:,.2f}'.format(o.house_rent)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 0;">Conveyance Allowance</td>
                                    <td style="padding: 2px 0;"></td>
                                    <td style="padding: 2px 0; text-align: right; font-family: 'Times New Roman', serif;">
                                        <t t-esc="'{:,.2f}'.format(o.conveyance_allowance)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 0;">Utilities</td>
                                    <td style="padding: 2px 0;"></td>
                                    <td style="padding: 2px 0; text-align: right; font-family: 'Times New Roman', serif;">
                                        <t t-esc="'{:,.2f}'.format(o.utilities_allowance)"/>
                                    </td>
                                </tr>
                                <tr t-if="o.other_allowance">
                                    <td style="padding: 2px 0;">Other Allowance</td>
                                    <td style="padding: 2px 0;"></td>
                                    <td style="padding: 2px 0; text-align: right; font-family: 'Times New Roman', serif;">
                                        <t t-esc="'{:,.2f}'.format(o.other_allowance)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 4px; text-align: right;" colspan="2">Gross Rs.</td>
                                    <td style="padding-top: 4px; text-align: right; border-bottom: 1.5px double #000; font-weight: normal;">
                                        <span style="border-top: 1px solid #000; display: inline-block; width: 100%;"><t t-esc="'{:,.2f}'.format(o.gross_salary)"/></span>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- 2. Medical Facilities -->
                        <div style="margin-bottom: 22px;">
                            <div style="text-decoration: underline; margin-bottom: 8px;">2. Medical Facilities</div>

                            <div style="margin-left: 20px; margin-bottom: 10px;">
                                <div style="text-decoration: underline; margin-bottom: 4px;">a. Out-Patient Treatment</div>
                                <p style="text-align: justify; margin: 0; line-height: 1.4;">
                                    <t t-esc="o.medical_outpatient or 'You will be entitled to reimbursement of money actually spent on medical treatment for self, wife and dependent children subject to a maximum of one Gross salary per annum.'"/>
                                </p>
                            </div>

                            <div style="margin-left: 20px;">
                                <div style="text-decoration: underline; margin-bottom: 4px;">b. Group Hospitalisation Insurance</div>
                                <p style="text-align: justify; margin: 0; line-height: 1.4;">
                                    <t t-esc="o.medical_hospitalisation or 'You will be entitled to reimbursement as per Company Rules in case of hospitalisation for self, wife and two dependent children.'"/>
                                </p>
                            </div>
                        </div>

                        <!-- Continuation Line -->
                        <div style="text-align: right; font-size: 13.5px; margin-top: 30px;">
                            Cont'd...... 2 ...
                        </div>
                    </div>


                    <!-- ========================================================
                         PAGE 2
                    ========================================================= -->
                    <div style="page-break-before: always; break-before: page; margin: 0; padding: 0;">
                        
                        <!-- Top Page Number (Centered) -->
                        <div style="text-align: center; font-size: 14px; margin-bottom: 22px;">
                            - 2 -
                        </div>

                        <!-- Clause 3 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">3.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    <span style="text-decoration: underline;">Group Life Insurance</span><br/>
                                    You will be entitled to a Group Insurance Life Cover as per Company Rules.
                                </td>
                            </tr>
                        </table>

                        <!-- Clause 4 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">4.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    <span style="text-decoration: underline;">Leave</span><br/>
                                    Your leave entitlement will be as per Company Rules.
                                </td>
                            </tr>
                        </table>

                        <!-- Clause 5 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">5.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    <span style="text-decoration: underline;">Probationary Period</span><br/>
                                    You will be on a probationary period for <t t-esc="o.probation_period or 'three months'"/>, which may be extended at the sole discretion of the Company. Please note that your services are liable to termination without notice and without assigning any reason during your probationary period.
                                </td>
                            </tr>
                        </table>

                        <!-- Clause 6 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">6.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    <span style="text-decoration: underline;">Confirmation</span><br/>
                                    You may be confirmed in your appointment on satisfactory completion of your probationary period.
                                </td>
                            </tr>
                        </table>

                        <!-- Clause 7 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">7.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    <span style="text-decoration: underline;">Termination</span><br/>
                                    After confirmation, either side may give one month notice or pay the equivalent of one month pay in lieu and terminate the employment.
                                </td>
                            </tr>
                        </table>

                        <!-- Clause 8 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">8.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    Your services will be transferable to any location or Company within "ALLIED GROUP OF COMPANIES" or any Company administered by the Company.
                                </td>
                            </tr>
                        </table>

                        <!-- Clause 9 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">9.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    Your designation, responsibilities or duties may change from time to time at the discretion of the Company.
                                </td>
                            </tr>
                        </table>

                        <!-- Clause 10 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">10.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    You will be subject to our Company Rules as are issued from time to time and are applicable to employees of your position.
                                </td>
                            </tr>
                        </table>

                        <!-- Clause 11 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">11.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    You shall employ yourself efficiently, diligently and to the best of your ability and shall devote your whole time to the duties of the service and you shall not engage directly or indirectly in any trade, business or occupation on your own account except as may be permitted by the Company in writing and shall not (except in case of accident or sickness certified by competent medical authority) absent yourself from your duties without having first obtained permission from the Company or its authorised officers.
                                </td>
                            </tr>
                        </table>

                        <!-- Continuation Line -->
                        <div style="text-align: right; font-size: 13.5px; margin-top: 25px;">
                            Cont'd...... 3 ...
                        </div>
                    </div>


                    <!-- ========================================================
                         PAGE 3
                    ========================================================= -->
                    <div style="page-break-before: always; break-before: page; margin: 0; padding: 0;">
                        
                        <!-- Top Page Number (Centered) -->
                        <div style="text-align: center; font-size: 14px; margin-bottom: 22px;">
                            - 3 -
                        </div>

                        <!-- Clause 12 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 14px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">12.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    You will not divulge directly or indirectly to any person or body any knowledge or information which you may acquire concerning the affairs, property, enterprise and undertaking of the company including its business and trade matters and secrets.
                                </td>
                            </tr>
                        </table>

                        <!-- Clause 13 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 14px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">13.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    Any overseas training or educational costs incurred by the Company on your behalf shall be refundable to the Company provided you choose to leave service within the subsequent 30 months.
                                </td>
                            </tr>
                        </table>

                        <!-- Clause 14 -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                            <tr>
                                <td style="width: 32px; vertical-align: top; font-size: 14px;">14.</td>
                                <td style="vertical-align: top; text-align: justify; font-size: 14px; line-height: 1.4;">
                                    This offer is valid for acceptance within <t t-esc="o.validity_days or 45"/> days from the date of issuance of this letter and thereafter is subject to sole discretion of Allied Management to either extend or cancel this offer.
                                </td>
                            </tr>
                        </table>

                        <!-- Acceptance Sentence -->
                        <p style="margin-bottom: 22px; line-height: 1.4;">
                            If the above terms are acceptable to you please sign the duplicate copy thereof in token of your acceptance.
                        </p>

                        <!-- Signatures Table (Left Company, Right Candidate) -->
                        <table style="width: 100%; border-collapse: collapse; margin-top: 30px;">
                            <tr>
                                <td style="width: 55%; vertical-align: top; font-size: 14px; line-height: 1.35;">
                                    Yours Faithfully<br/>
                                    <strong><t t-esc="o.company_id.name or 'ALLIED ENGINEERING &amp; SERVICES (PRIVATE) LTD.'"/></strong>
                                    <div style="height: 55px;"/>
                                    <strong style="text-decoration: underline;"><t t-esc="o.signatory_name or 'KHWAJA AHAD RAHMAN'"/></strong><br/>
                                    <strong><t t-esc="o.signatory_title or 'DIRECTOR'"/></strong>
                                </td>
                                <td style="width: 45%; vertical-align: top; font-size: 14px; padding-left: 30px;">
                                    <div style="margin-bottom: 50px; letter-spacing: 2px;">
                                        <strong>A c c e p t e d</strong>
                                    </div>
                                    <div style="margin-bottom: 6px;">
                                        (<t t-if="o.gender == 'female'">Ms. </t><t t-else="">Mr. </t><t t-esc="o.candidate_name"/>)
                                    </div>
                                    <div>
                                        Dated: ___________
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Footer Row: cc and Initials Box -->
                        <table style="width: 100%; border-collapse: collapse; margin-top: 45px;">
                            <tr>
                                <td style="width: 50%; font-size: 13.5px; vertical-align: bottom;">
                                    cc: &amp;nbsp;&amp;nbsp;&amp;nbsp; Personal File
                                </td>
                                <td style="width: 50%; text-align: right; vertical-align: bottom;">
                                    <span style="border: 1.5px solid #000; padding: 2px 8px; font-weight: bold; font-size: 12px; display: inline-block;">
                                        <t t-esc="o.drafter_initials or 'HS'"/>
                                    </span>
                                </td>
                            </tr>
                        </table>

                    </div>

                </div>
            </t>
        </t>
    </template>

</odoo>
