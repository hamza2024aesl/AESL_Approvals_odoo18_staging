<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_aesl_lwp_report_search" model="ir.ui.view">
        <field name="name">aesl.lwp.report.search</field>
        <field name="model">aesl.lwp.report</field>
        <field name="arch" type="xml">
            <search string="LWP Report">
                <field name="employee_id"/>
                <field name="attendance_date"/>
                <field name="deduction_status"/>
                <separator/>
                <filter
                        name="filter_lwp"
                        string="LWP"
                        domain="[('deduction_status', '=', 'lwp')]"/>
                <filter
                        name="filter_leave"
                        string="Leave"
                        domain="[('deduction_status', '=', 'leave')]"/>
                <filter
                        name="filter_present"
                        string="Present"
                        domain="[('deduction_status', '=', 'present')]"/>

                <separator/>
                <group expand="0" string="Group By">
                    <filter
                            name="group_employee"
                            string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter
                            name="group_date"
                            string="Date"
                            context="{'group_by': 'attendance_date'}"/>
                    <filter
                            name="group_status"
                            string="Deduction Status"
                            context="{'group_by': 'deduction_status'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="view_aesl_lwp_report_tree" model="ir.ui.view">
        <field name="name">aesl.lwp.report.tree</field>
        <field name="model">aesl.lwp.report</field>
        <field name="arch" type="xml">
            <list string="LWP Report">
                <field name="employee_id"/>
                <field name="attendance_date"/>
                <field name="status2"/>
                <field name="in_status"/>
                <field name="on_leave"/>
                <field name="deduction_status"
                       widget="badge"
                       decoration-danger="deduction_status == 'lwp'"
                       decoration-success="deduction_status == 'present'"
                       decoration-warning="deduction_status == 'leave'"/>

            </list>
        </field>
    </record>

    <record id="action_aesl_lwp_report" model="ir.actions.act_window">
        <field name="name">LWP Report</field>
        <field name="res_model">aesl.lwp.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_aesl_lwp_report_tree"/>
        <field name="search_view_id" ref="view_aesl_lwp_report_search"/>
    </record>

