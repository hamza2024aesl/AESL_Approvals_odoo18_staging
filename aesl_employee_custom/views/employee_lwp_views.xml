    <record id="action_refresh_lwp_server" model="ir.actions.server">
        <field name="name">Refresh LWP</field>
        <field name="model_id" ref="model_aesl_lwp_report"/>
        <field name="binding_model_id" ref="model_aesl_lwp_report"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
               action = model.action_refresh_lwp()
        </field>
    </record>

    <menuitem
    id="menu_aesl_lwp_root"
    name="LWP Report"
    web_icon="aesl_employee_custom,static/description/lwp_menu.jpg"
    action="aesl_employee_custom.action_aesl_lwp_report"
    sequence="50"/>

    <menuitem
    id="menu_aesl_lwp_process"
    name="LWP Update"
    parent="aesl_employee_custom.menu_aesl_lwp_root"
    action="aesl_employee_custom.action_aesl_lwp_report"
    sequence="50"/>



