<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_aesl_lwp_report_search" model="ir.ui.view">
        <field name="name">aesl.lwp.report.search</field>
        <field name="model">aesl.lwp.report</field>
        <field name="arch" type="xml">
            <search string="LWP Report">
                <field name="employee_id"/>
                <field name="attendance_date"/>
                <field name="status2"/>
                <field name="in_status"/>
                <field name="out_status"/>

                <filter name="filter_my_lwp" string="My LWP"
                        domain="[('employee_id.user_id', '=', uid)]"/>

                <filter name="filter_absent" string="Absent"
                        domain="[('status2', '=', 'absent')]"/>

                <filter name="filter_missed_in" string="Missed Check In"
                        domain="[('status2', '=', 'missed_check_in')]"/>

                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'attendance_date'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="view_aesl_lwp_report_tree" model="ir.ui.view">
        <field name="name">aesl.lwp.report.tree</field>
        <field name="model">aesl.lwp.report</field>
        <field name="arch" type="xml">
            <list string="LWP Report">
                <field name="employee_id"/>
                <field name="attendance_date"/>
                <field name="status2"/>
                <field name="in_status"/>
                <field name="out_status"/>
                <field name="on_leave"/>
                <field name="deduction_status"
                       widget="badge"
                       decoration-danger="deduction_status == 'lwp'"
                       decoration-success="deduction_status == 'present'"
                       decoration-warning="deduction_status == 'leave'"/>

            </list>
        </field>
    </record>

