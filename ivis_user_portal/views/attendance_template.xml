<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <template id="employee_list_view_portal">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <div id="loading-screen" class="hidden">
                <div id="loading-icon"/>
            </div>

            <div class="attendance-portal-header my-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a href="/my" title="Go Back" class="btn btn-light px-2 mx-2">
                        <i class="oi oi-chevron-left"/>
                    </a>
                    <h3 class="my-0 mt-1 me-auto attendance-page-title">Attendances</h3>

                    <div class="attendance-controls d-flex align-items-center flex-wrap gap-2">
                        <!-- Show LWP switch -->
                        <div class="form-check form-switch form-switch-lg mb-0 d-flex align-items-center">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="attendance-show-lwp"
                                   t-att-checked="'checked' if show_lwp else None"/>
                            <label class="form-check-label attendance-switch-label"
                                   for="attendance-show-lwp">Show LWP</label>
                        </div>
                        <!-- Sub-Ordinates switch -->
                        <div t-if="is_manager"
                             class="form-check form-switch form-switch-lg mb-0 d-flex align-items-center">
                            <input class="form-check-input" type="checkbox" id="attendance-sub-ordinates"/>
                            <label class="form-check-label attendance-switch-label"
                                   for="attendance-sub-ordinates">Sub-Ordinates</label>
                        </div>
                        <!-- Group By -->
                        <div class="btn-group attendance-groupby-container">
                            <button class="btn btn-secondary attendance-ctrl-btn dropdown-toggle"
                                    type="button" data-bs-toggle="dropdown">
                                Group By
                            </button>
                            <div class="dropdown-menu p-3">
                                <div class="form-check">
                                    <input class="form-check-input group-by-checkbox-attendances"
                                           type="checkbox" value="month" id="groupByMonth"/>
                                    <label class="form-check-label" for="groupByMonth">Month</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input group-by-checkbox-attendances"
                                           type="checkbox" value="year" id="groupByYear"/>
                                    <label class="form-check-label" for="groupByYear">Year</label>
                                </div>
                                <div t-if="is_manager and subordinate" class="form-check">
                                    <input class="form-check-input group-by-checkbox-attendances"
                                           type="checkbox" value="employee" id="groupByEmp"/>
                                    <label class="form-check-label" for="groupByEmp">Employee</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <t t-call="portal.portal_searchbar">
                        <t t-set="title">&#8203;</t>
                        <t t-if="request.env.user.employee_id.company_id.allow_portal_attendance">
                            <button id="check_inout_portal"
                                    class="o_hr_attendance_sign_in_out_icon btn btn-secondary btn-fill-success attendance-checkin-btn"
                                    title="Check In"
                                    style="margin-left:auto; padding: 0px 10px 0px 10px;">
                                <i class="fa fa-sign-in me-1"/>
                                Check In/Out
                            </button>
                        </t>
                    </t>
                </div>
            </div>

            <t t-if="not attendances">
                <p class="alert alert-warning">There are currently no attendances.</p>
            </t>

            <t t-call="portal.portal_table">
                <t t-if="attendances">
                    <thead>
                        <tr class="active">
                            <th class="att2-name-col">Name</th>
                            <th class="att2-datetime-col text-right">Check In</th>
                            <th class="att2-datetime-col text-right">Check Out</th>
                            <th class="att2-status-col text-right">Status</th>
                            <th class="att2-status-col text-right">In Status</th>
                            <th class="att2-status-col text-right">Out Status</th>
                            <th class="att2-status-col text-right">Attendance Status</th>
                            <th class="att2-process-col text-right">Process</th>
                        </tr>
                    </thead>
                </t>
                <tbody>
                    <t t-if="grouped_attendances">
                        <t t-foreach="grouped_attendances.items()" t-as="group">
                            <tr class="bg-light">
                                <td colspan="11">
                                    <button class="btn btn-link btn-sm attendance-expand-btn"
                                            t-att-data-group-id="group[0]">
                                        <i class="fa fa-plus attendance-expand-icon"/>
                                    </button>
                                    <strong>
                                        <t t-if="group_by == 'month'">Month: <t t-out="group[0]"/></t>
                                        <t t-elif="group_by == 'year'">Year: <t t-out="group[0]"/></t>
                                        <t t-elif="group_by == 'employee'"><t t-out="group[0]"/></t>
                                    </strong>
                                </td>
                            </tr>
                            <t t-foreach="group[1]" t-as="attendance">
                                <tr t-attf-data-group-id="{{group[0]}}" class="attendance-group-row"
                                    style="display: none;">
                                    <td class="att2-name-col" style="padding-left: 25px;">
                                        <img t-if="attendance.employee_id.image_1920"
                                             t-att-src="image_data_uri(attendance.employee_id.image_1920)"
                                             class="rounded img-fluid mx-2" style="width: 24px;" alt="Profile"/>
                                        <img t-else="" src="/hr/static/src/img/default_image.png"
                                             class="rounded img-fluid mx-2" style="width: 24px;" alt="Default Avatar"/>
                                        <span t-att-title="attendance.employee_id.name">
                                            <t t-out="attendance.employee_id.name"/>
                                        </span>
                                    </td>
                                    <td class="att2-datetime-col text-right">
                                        <t t-out="attendance.check_in.astimezone(timezone).strftime(date_format)"/>
                                    </td>
                                    <td class="att2-datetime-col text-right">
                                        <t t-if="attendance.check_out">
                                            <t t-out="attendance.check_out.astimezone(timezone).strftime(date_format)"/>
                                        </t>
                                    </td>
                                    <td class="att2-status-col text-right">
                                        <t t-if="attendance.status2">
                                            <t t-esc="dict(attendance.fields_get(allfields=['status2'])['status2']['selection']).get(attendance.status2, '')"/>
                                        </t>
                                    </td>
                                    <td class="att2-status-col text-right">
                                        <t t-if="attendance.in_status">
                                            <t t-esc="dict(attendance.fields_get(allfields=['in_status'])['in_status']['selection']).get(attendance.in_status, '')"/>
                                        </t>
                                    </td>
                                    <td class="att2-status-col text-right">
                                        <t t-if="attendance.out_status">
                                            <t t-esc="dict(attendance.fields_get(allfields=['out_status'])['out_status']['selection']).get(attendance.out_status, '')"/>
                                        </t>
                                    </td>
                                    <td class="att2-status-col text-right">
                                        <t t-if="attendance.attendance_status">
                                            <t t-esc="dict(attendance.fields_get(allfields=['attendance_status'])['attendance_status']['selection']).get(attendance.attendance_status, '')"/>
                                        </t>
                                    </td>
                                    <td class="att2-status-col text-right">
                                        <t t-if="attendance.state">
                                            <t t-esc="dict(attendance.fields_get(allfields=['state'])['state']['selection']).get(attendance.state, '')"/>
                                        </t>
                                    </td>
                                    <td class="att2-process-col text-right">
                                        <t t-if="attendance.check_in and attendance.check_out and attendance.state == 'done' and request.env.user.employee_id.company_id.allow_change_request">
                                            <a href="#" id="modal_a"
                                               title="Change Request"
                                               aria-label="Change Request"
                                               t-att-class="'btn btn-sm btn-primary ' + ('disabled' if attendance.request_created else '')"
                                               role="button"
                                               data-bs-toggle="modal"
                                               t-attf-data-bs-target="#change_request_popup{{attendance.id}}">
                                                <i class="fa fa-arrow-circle-right"/>
                                                <span class="d-none d-md-inline">Change Request</span>
                                            </a>
                                        </t>
                                    </td>
                                </tr>
                                <div class="modal fade" t-attf-id="change_request_popup{{attendance.id}}"
                                     role="dialog" style="display:none; transition: opacity 0.15s linear;">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Change Request</h5>
                                                <button type="button" class="btn-close"
                                                        data-bs-dismiss="modal" aria-label="Close"/>
                                            </div>
                                            <div class="modal-body">
                                                <form class="formC" method="post"
                                                      t-attf-id="change_request_form{{attendance.id}}">
                                                    <div class="row o_portal_details">
                                                        <div>
                                                            <div class="row">
                                                                <div t-attf-id="att_duration_err_id{{attendance.id}}"
                                                                     style="display: none">
                                                                    <p class="alert alert-warning">Date is invalid</p>
                                                                </div>
                                                                <input type="hidden" name="csrf_token"
                                                                       t-att-value="request.csrf_token()"/>
                                                                <input type="hidden" name="id"
                                                                       t-attf-value="{{attendance.id}}"/>
                                                                <div t-attf-class="mb-3 col-xl-6">
                                                                    <label class="col-form-label" for="reason">Reason</label>
                                                                    <select id="reason_type" name="reason" class="form-select">
                                                                        <option value="change_shift">Shift Change</option>
                                                                        <option value="at_bank">At Bank</option>
                                                                        <option value="forgot_to_mark">Forgot to Mark</option>
                                                                        <option value="out_station">Out Station Duty</option>
                                                                        <option value="others">Others</option>
                                                                        <option value="duplicate">Ignore</option>
                                                                        <option value="ot_adjustment">Overtime Adjustment</option>
                                                                    </select>
                                                                </div>
                                                                <div t-attf-class="mb-3 col-xl-6">
                                                                    <label class="col-form-label" for="desc">Description</label>
                                                                    <input type="text" id="desc_id" name="desc"
                                                                           t-attf-class="form-control description-input"
                                                                           placeholder="Description"/>
                                                                </div>
                                                                <div t-attf-class="mb-3 col-xl-6">
                                                                    <label class="col-form-label" for="date">From</label>
                                                                    <input type="datetime-local"
                                                                           t-attf-id="new_check_in_id{{attendance.id}}"
                                                                           name="new_check_in"
                                                                           class="form-control monitor-datetime new_check_in_id"
                                                                           placeholder="From"
                                                                           t-att-value="attendance.check_in.astimezone(timezone).strftime(date_format)"/>
                                                                </div>
                                                                <div t-attf-class="mb-3 col-xl-6">
                                                                    <label class="col-form-label" for="date">To</label>
                                                                    <input type="datetime-local"
                                                                           t-attf-id="new_check_out_id{{attendance.id}}"
                                                                           name="new_check_out"
                                                                           class="form-control monitor-datetime new_check_out_id"
                                                                           placeholder="To"
                                                                           t-att-value="(attendance.check_out and attendance.check_out.astimezone(timezone).strftime(date_format)) or ''"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                            <div class="modal-footer">
                                                <button t-attf-id="request_submit_id{{attendance.id}}"
                                                        type="submit"
                                                        t-attf-form="change_request_form{{attendance.id}}"
                                                        value="Update"
                                                        class="btn btn-primary" disabled="1">
                                                    Apply
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </t>

                    <t t-foreach="attendances" t-as="attendance"
                       t-if="attendances and not grouped_attendances">
                        <tr>
                            <td class="att2-name-col">
                                <img t-if="attendance.employee_id.image_1920"
                                     t-att-src="image_data_uri(attendance.employee_id.image_1920)"
                                     class="rounded img-fluid mx-2" style="width: 24px;" alt="Profile"/>
                                <img t-else="" src="/hr/static/src/img/default_image.png"
                                     class="rounded img-fluid mx-2" style="width: 24px;" alt="Default Avatar"/>
                                <span t-att-title="attendance.employee_id.name">
                                    <t t-out="attendance.employee_id.name"/>
                                </span>
                            </td>
                            <td class="att2-datetime-col text-right">
                                <t t-out="attendance.check_in.astimezone(timezone).strftime(date_format)"/>
                            </td>
                            <td class="att2-datetime-col text-right">
                                <t t-if="attendance.check_out">
                                    <t t-out="attendance.check_out.astimezone(timezone).strftime(date_format)"/>
                                </t>
                            </td>
                            <td class="att2-status-col text-right">
                                <t t-if="attendance.status2">
                                    <t t-esc="dict(attendance.fields_get(allfields=['status2'])['status2']['selection']).get(attendance.status2, '')"/>
                                </t>
                            </td>
                            <td class="att2-status-col text-right">
                                <t t-if="attendance.in_status">
                                    <t t-esc="dict(attendance.fields_get(allfields=['in_status'])['in_status']['selection']).get(attendance.in_status, '')"/>
                                </t>
                            </td>
                            <td class="att2-status-col text-right">
                                <t t-if="attendance.out_status">
                                    <t t-esc="dict(attendance.fields_get(allfields=['out_status'])['out_status']['selection']).get(attendance.out_status, '')"/>
                                </t>
                            </td>
                            <td class="att2-status-col text-right">
                                <t t-if="attendance.attendance_status">
                                    <t t-esc="dict(attendance.fields_get(allfields=['attendance_status'])['attendance_status']['selection']).get(attendance.attendance_status, '')"/>
                                </t>
                            </td>
                            <td class="att2-status-col text-right">
                                <t t-if="attendance.state">
                                    <t t-esc="dict(attendance.fields_get(allfields=['state'])['state']['selection']).get(attendance.state, '')"/>
                                </t>
                            </td>
                            <td class="att2-process-col text-right">
                                <t t-if="attendance.check_in and attendance.check_out and attendance.state == 'done' and request.env.user.employee_id.company_id.allow_change_request">
                                    <a href="#" id="modal_a"
                                       title="Change Request"
                                       aria-label="Change Request"
                                       t-att-class="'btn btn-sm btn-primary ' + ('disabled' if attendance.request_created else '')"
                                       role="button"
                                       data-bs-toggle="modal"
                                       t-attf-data-bs-target="#change_request_popup{{attendance.id}}">
                                        <i class="fa fa-arrow-circle-right"/>
                                        <span class="d-none d-md-inline">Change Request</span>
                                    </a>
                                </t>
                            </td>
                        </tr>
                        <div class="modal fade" t-attf-id="change_request_popup{{attendance.id}}"
                             role="dialog" style="display:none; transition: opacity 0.15s linear;">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Change Request</h5>
                                        <button type="button" class="btn-close"
                                                data-bs-dismiss="modal" aria-label="Close"/>
                                    </div>
                                    <div class="modal-body">
                                        <form class="formC" method="post"
                                              t-attf-id="change_request_form{{attendance.id}}">
                                            <div class="row o_portal_details">
                                                <div>
                                                    <div class="row">
                                                        <div t-attf-id="att_duration_err_id{{attendance.id}}"
                                                             style="display: none">
                                                            <p class="alert alert-warning">Date is invalid</p>
                                                        </div>
                                                        <input type="hidden" name="csrf_token"
                                                               t-att-value="request.csrf_token()"/>
                                                        <input type="hidden" name="id"
                                                               t-attf-value="{{attendance.id}}"/>
                                                        <div t-attf-class="mb-3 col-xl-6">
                                                            <label class="col-form-label" for="reason">Reason</label>
                                                            <select id="reason_type" name="reason" class="form-select">
                                                                <option value="change_shift">Shift Change</option>
                                                                <option value="at_bank">At Bank</option>
                                                                <option value="forgot_to_mark">Forgot to Mark</option>
                                                                <option value="out_station">Out Station Duty</option>
                                                                <option value="others">Others</option>
                                                                <option value="duplicate">Ignore</option>
                                                                <option value="ot_adjustment">Overtime Adjustment</option>
                                                            </select>
                                                        </div>
                                                        <div t-attf-class="mb-3 col-xl-6">
                                                            <label class="col-form-label" for="desc">Description</label>
                                                            <input type="text" id="desc_id" name="desc"
                                                                   t-attf-class="form-control description-input"
                                                                   placeholder="Description"/>
                                                        </div>
                                                        <div t-attf-class="mb-3 col-xl-6">
                                                            <label class="col-form-label" for="date">From</label>
                                                            <input type="datetime-local"
                                                                   t-attf-id="new_check_in_id{{attendance.id}}"
                                                                   name="new_check_in"
                                                                   class="form-control monitor-datetime new_check_in_id"
                                                                   placeholder="From"
                                                                   t-att-value="attendance.check_in.astimezone(timezone).strftime(date_format)"/>
                                                        </div>
                                                        <div t-attf-class="mb-3 col-xl-6">
                                                            <label class="col-form-label" for="date">To</label>
                                                            <input type="datetime-local"
                                                                   t-attf-id="new_check_out_id{{attendance.id}}"
                                                                   name="new_check_out"
                                                                   class="form-control monitor-datetime new_check_out_id"
                                                                   placeholder="To"
                                                                   t-att-value="(attendance.check_out and attendance.check_out.astimezone(timezone).strftime(date_format)) or ''"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="modal-footer">
                                        <button t-attf-id="request_submit_id{{attendance.id}}"
                                                type="submit"
                                                t-attf-form="change_request_form{{attendance.id}}"
                                                value="Update"
                                                class="btn btn-primary" disabled="1">
                                            Apply
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </tbody>
            </t>
        </t>
    </template>
</odoo>